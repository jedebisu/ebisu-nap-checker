{
  "expo": {
    "name": "G-MAPS",
    "slug": "gmaps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#00539B"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gmaps.demo",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show NAPs near you"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00539B"
      },
      "package": "com.gmaps.demo",
      "enableDangerousExperimentalLeanBuilds": true,
      "minSdkVersion": 21,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB5rkLpbkqqIMo6FYMVj7gqoLGH3uGWoWg"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "versionCode": 2
    },
    "plugins": []
  }
}
