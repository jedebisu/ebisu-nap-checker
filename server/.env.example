# EBISU NAP Checker — server environment
# Copy to server/.env and fill in. Blank values fall back to safe dev behavior.

PORT=3002

# Database (accounts only; NAP data is NOT stored here)
DATABASE_URL=
# Separate database for automated tests
TEST_DATABASE_URL=

# Secret for signing JWTs — make it a long random string
JWT_SECRET=

# Upstream NAP data API (read-only proxy target)
RENDER_API_URL=https://selfie-api-sqgh.onrender.com

# Email sending (company domain SMTP). Leave SMTP_HOST blank to use the
# dev fallback: emails are written as files into server/outbox/.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Admin page password (leave blank to disable the admin page entirely)
ADMIN_PASSWORD=
