# Database — local dev uses discrete vars; production Render uses DATABASE_URL.
# NEVER commit real values.
DB_USER=yanggee
DB_HOST=localhost
DB_NAME=selfie_attendance
DB_PORT=5432
DB_PASSWORD=

# Connection string used in production (Render). Do not set in local .env.
# DATABASE_URL=postgres://...

# Server
PORT=3001
NODE_ENV=development

# Auth
JWT_SECRET=dev-only-change-me
ADMIN_TOKEN=admin-token-change-in-prod

# CORS — comma-separated origins (empty = no browser CORS in dev)
CORS_ORIGINS=
